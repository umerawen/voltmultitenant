# Copy this file to .env.local and fill in the values (Supabase → Settings → API).
# .env.local is git-ignored, so your keys never get committed.
#
# These two are public by design: they end up in the browser bundle, and the
# database's row-level security is what actually protects the data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# The api/ functions only run on Vercel (or with `vercel dev`). Their secrets
# (SUPABASE_SERVICE_KEY, DISCORD_BOT_TOKEN, GEMINI_API_KEY, ...) live in
# Vercel → Settings → Environment Variables. Never put them in a VITE_ variable.
